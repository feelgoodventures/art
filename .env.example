# Etsy Open API v3 credentials (developer portal: https://www.etsy.com/developers/your-apps)
ETSY_API_KEY=
# Etsy now expects "keystring:shared_secret" in the x-api-key header; set this if your app has one.
ETSY_SHARED_SECRET=

# Awin affiliate IDs (leave blank until approved; links then go straight to Etsy)
AWIN_MERCHANT_ID=
AWIN_AFFILIATE_ID=

# Public site address, used for SEO tags and the sitemap
NEXT_PUBLIC_SITE_URL=https://wallglamup.com

# Optional: form action URL from your email tool (e.g. a Kit form) for the waitlist
NEXT_PUBLIC_SIGNUP_ACTION=
